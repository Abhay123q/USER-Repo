# =================================================================
# 1. LOCAL DEVELOPMENT (MySQL)
# Used when running locally on your machine with a local MySQL server
# =================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=user_management_db

# =================================================================
# 2. CLOUD DEPLOYMENT (Netlify, Vercel, Render)
# Required for Netlify/cloud since localhost MySQL is not accessible.
# Supports Supabase, Neon, Render, or any PostgreSQL provider.
# Setting either DATABASE_URL or SUPABASE_DATABASE_URL automatically
# switches the app to PostgreSQL mode and auto-seeds initial tables.
# =================================================================
# DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# SUPABASE_DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# =================================================================
# 3. EMAIL NOTIFICATIONS (Nodemailer / Gmail)
# Optional: Used to send real email notifications from the dashboard
# Generate a Gmail App Password: https://myaccount.google.com/apppasswords
# =================================================================
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# =================================================================
# 4. SERVER CONFIGURATION
# =================================================================
PORT=3000
